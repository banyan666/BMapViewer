{
  "name": "b-map-viewer",
  "version": "0.1.4",
  "description": "面向 Vue 3 应用的 Cesium 地理信息可视化 SDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banyan666/BMapViewer.git"
  },
  "homepage": "https://banyan666.github.io/BMapViewer/docs/",
  "bugs": {
    "url": "https://github.com/banyan666/BMapViewer/issues"
  },
  "type": "module",
  "main": "./BMapViewer/b-map-viewer.umd.cjs",
  "module": "./BMapViewer/b-map-viewer.js",
  "exports": {
    ".": {
      "import": "./BMapViewer/b-map-viewer.js",
      "require": "./BMapViewer/b-map-viewer.umd.cjs"
    },
    "./style.css": "./BMapViewer/style.css"
  },
  "files": [
    "BMapViewer",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "generate:demo-tiles": "node scripts/generate-demo-tiles.mjs",
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "vue3",
    "cesium",
    "gis",
    "map",
    "visualization"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "cesium": ">=1.118.0 <2",
    "vue": ">=3.4.0 <4"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "@zip.js/zip.js": "2.7.73",
    "pako": "^2.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "cesium": "1.118.2",
    "codemirror": "^6.0.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-cesium": "^1.2.23",
    "vitepress": "2.0.0-alpha.16",
    "vue": "^3.5.13"
  }
}
